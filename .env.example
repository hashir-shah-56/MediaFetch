# Server Port
PORT=3000

# Environment (development | production | test)
NODE_ENV=development

# Allowed Frontend Origin for CORS (comma-separated or single URL)
FRONTEND_ORIGIN=http://localhost:3000

# Instagram Provider Configuration
# Set INSTAGRAM_PROVIDER to 'api' (default) or 'mock' (for local testing without external API key)
INSTAGRAM_PROVIDER=api
INSTAGRAM_API_KEY=
INSTAGRAM_API_BASE_URL=https://api.instagram-provider.example.com
INSTAGRAM_TIMEOUT_MS=10000

# YouTube Provider Configuration (Official YouTube Data API v3)
# Set YOUTUBE_PROVIDER to 'api' (default) or 'mock' (for local testing without external API key)
YOUTUBE_PROVIDER=api
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_TIMEOUT_MS=10000

# ── Authorized-Content Download Configuration ──────────────────────────────
# Job deadline including processing and streaming (1–600000 milliseconds)
DOWNLOAD_TIMEOUT_MS=300000

# Maximum simultaneous jobs, held through streaming/cleanup (1–8)
DOWNLOAD_MAX_CONCURRENT=2

# Final-file limit in MiB (1–2048); total job storage polled at twice this limit
DOWNLOAD_MAX_FILE_SIZE_MB=500

# Optional: override binary paths if yt-dlp / ffmpeg / ffprobe are not on PATH
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
